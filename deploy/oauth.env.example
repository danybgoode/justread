# Copy to deploy/oauth.env to turn on Auth0 single sign-on, then
# `docker compose up -d miniflux`. Leave the file absent for password login.
#
# Every line here must have a real value: Miniflux refuses to start with a
# provider declared but unconfigured.
#
# Do NOT add DISABLE_LOCAL_AUTH=1 here. Since Miniflux 76889f08 it also rejects Basic auth on the
# API, and the landing page's /api/register authenticates that way (as admin, then as the new user):
# every signup would fail with 401 while the reader's healthcheck stays green. Move register to an
# admin API key first.
OAUTH2_PROVIDER=oidc
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_OIDC_DISCOVERY_ENDPOINT=
OAUTH2_OIDC_PROVIDER_NAME=Auth0
OAUTH2_REDIRECT_URL=https://app.panfleto.win/oauth2/oidc/callback
OAUTH2_USER_CREATION=1
