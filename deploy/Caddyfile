# Landing page + registration/MCP API routes.
panfleto.win, www.panfleto.win {
	encode zstd gzip
	reverse_proxy landing:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Miniflux itself.
app.panfleto.win {
	encode zstd gzip
	reverse_proxy miniflux:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
}

# aomx alpha ingress: private-match requests use individual invite codes and
# the server-side Golden Frijoles admission flag. Ingest stays operator-only.
# Both aomx containers are attached only to the separate aomx_proxy network.
alpha-api.159.54.158.4.sslip.io {
	handle /v1/match/* {
		reverse_proxy aomx-match:8790 {
			header_up X-Aomx-Client-IP {remote_host}
		}
	}
	@alpha_operator remote_ip 187.168.160.163/32
	handle @alpha_operator {
		encode zstd gzip
		reverse_proxy aomx-ingest:8787
	}
	respond "Forbidden" 403
}

# Other tenants of this VM (see the caddy service in docker-compose.yml). Must stay LAST.
import /etc/caddy/sites/*.caddy
