# Copy to /opt/panfleto/deploy/.env on the host and chmod 600.
# Never commit the filled-in version.

# Postgres superuser password for the miniflux role (generate a fresh one).
POSTGRES_PASSWORD=

# Miniflux admin account. Rotate these - the previous values were committed
# to this repo in plaintext and are considered compromised.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Auth0 SSO is configured separately in deploy/oauth.env - see
# oauth.env.example. Leave that file absent to run with password login.

# Transactional email for the welcome message.
# Reaches BOTH containers: the landing page's /api/register (password signup) and the reader's
# internal/ui/user_onboarding.go (Auth0 signup). Until 2026-09-16 it reached only `landing`, so an
# Auth0 signup silently sent nothing.
RESEND_API_KEY=

# Telegram onboarding notifications. Same both-containers note as above. The message now carries the
# provisioning outcome ("14/16 starter feeds added, 2 failed: ..."), not just the fact of a signup.
TELEGRAM_BOT_TOKEN=

# Optional. Both default to the values that used to be hardcoded in the Go and the TypeScript, so
# leaving them unset changes nothing.
#PANFLETO_TELEGRAM_CHAT_ID=1517743559
#PANFLETO_EMAIL_FROM=Panflo <hello@panfleto.win>

# Article autofetch kill switches (Roadmap/01-reading-experience/article-autofetch, D4).
# Leave them unset for the defaults in docker-compose.yml (everything on). To turn a piece off,
# uncomment its line and run `docker compose up -d miniflux` - a restart, not a rebuild.
#FORCE_CRAWLER=0            # new feeds no longer get "Fetch original content" ticked
#FETCH_FALLBACK_CHAIN=      # empty: scrape directly only, never call unwall.app
#PREFETCH_WORKERS=0         # scrape inline during the poll again, as upstream Miniflux does
#FETCH_THIN_CONTENT_THRESHOLD=2000   # characters of text below which an article counts as a teaser
#PREFETCH_HOST_DELAY=2      # seconds between two requests to the same host

# --- The reader's image (Roadmap/09-platform-infra/ci-build-pipeline) -------------------------
# MINIFLUX_IMAGE is a MANAGED line: update.sh writes it on every run from the panfleto-core submodule
# pin, so the container always matches the commit `main` points at. Do not hand-edit it. It is absent
# from a fresh .env on purpose - docker-compose.yml falls back to the moving `:panfleto` tag until
# the first update.sh run, so compose commands (and backup.sh) work on a brand-new host.
#MINIFLUX_IMAGE=ghcr.io/danybgoode/panfleto-core:<written by update.sh>
#
# To roll back, pin a previous image here and re-run update.sh; delete the line and re-run to roll
# forward. NOT every commit has an image: the workflow started at the ci-build-pipeline commit, and
# it skips docs-only pushes. The real list of rollback targets is the registry, not `git log`:
#   gh api /repos/danybgoode/panfleto-core/actions/workflows -q '...'   # or the Actions tab
#   https://github.com/danybgoode/panfleto-core/pkgs/container/panfleto-core   # the tag list
#MINIFLUX_IMAGE_PIN=ghcr.io/danybgoode/panfleto-core:<a sha that has an image>
