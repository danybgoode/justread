# Copy to /opt/panfleto/deploy/.env on the host and chmod 600.
# Never commit the filled-in version.

# Postgres superuser password for the miniflux role (generate a fresh one).
POSTGRES_PASSWORD=

# Miniflux admin account. Rotate these - the previous values were committed
# to this repo in plaintext and are considered compromised.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Auth0 SSO is configured separately in deploy/oauth.env - see
# oauth.env.example. Leave that file absent to run with password login.

# Transactional email for the welcome message.
RESEND_API_KEY=

# Telegram onboarding notifications.
TELEGRAM_BOT_TOKEN=
